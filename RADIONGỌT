-- Biến toàn cục
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local aimTarget = nil

-- Hàm tìm mục tiêu mới (khi mục tiêu chết hoặc thoát)
local function GetClosest()
    local closest, dist = nil, math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character.Humanoid.Health > 0 then
            local pos = v.Character.HumanoidRootPart.Position
            local mag = (pos - lp.Character.HumanoidRootPart.Position).Magnitude
            if mag < dist then closest = v; dist = mag end
        end
    end
    return closest
end

-- Tabs
local MainTab = Window:CreateTab("Trang Chủ", "home")
local CombatTab = Window:CreateTab("Chiến Đấu", "sword")
local TrollTab = Window:CreateTab("Troll", "smile")

-- Logic Aimbot với tính năng tự đổi mục tiêu
local aimbotEnabled = false
MainTab:CreateToggle({
    Name = "Aimbot (Tự đổi mục tiêu)",
    Callback = function(v)
        aimbotEnabled = v
        spawn(function()
            while aimbotEnabled do
                if not aimTarget or aimTarget.Character.Humanoid.Health <= 0 or not aimTarget.Character then
                    aimTarget = GetClosest()
                end
                if aimTarget and aimTarget.Character then
                    workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, aimTarget.Character.Head.Position)
                end
                task.wait()
            end
        end)
    end
})

-- Fling & Fly
local flying = false
CombatTab:CreateToggle({
    Name = "Fly (Bay)",
    Callback = function(v)
        flying = v
        if flying then
            local bv = Instance.new("BodyVelocity", lp.Character.HumanoidRootPart)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.new(0, 50, 0)
        else
            lp.Character.HumanoidRootPart:FindFirstChild("BodyVelocity"):Destroy()
        end
    end
})

-- Jerk Troll (Pelvic Thrust)
local jerkActive = false
TrollTab:CreateToggle({
    Name = "Jerk Troll (Gồng lắc)",
    Callback = function(v)
        jerkActive = v
        spawn(function()
            while jerkActive do
                local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Tạo lực đẩy nhấp nhô liên tục
                    local thrust = Instance.new("BodyThrust", hrp)
                    thrust.Force = Vector3.new(0, 8000, 0)
                    task.wait(0.1)
                    thrust:Destroy()
                    task.wait(0.1)
                end
            end
        end)
    end
})

