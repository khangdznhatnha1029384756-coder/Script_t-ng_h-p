local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ==========================================
-- 1. HỆ THỐNG CHỌN NGÔN NGỮ (LANGUAGE SELECTOR)
-- ==========================================
local Lang = {} -- Biến lưu trữ ngôn ngữ
local LangGui = Instance.new("ScreenGui")
LangGui.Name = "RadioNgot_Lang"
LangGui.Parent = pcall(function() return CoreGui end) and CoreGui or localPlayer.PlayerGui

local bg = Instance.new("Frame", LangGui)
bg.Size = UDim2.new(1, 0, 1, 0); bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

local title = Instance.new("TextLabel", bg)
title.Size = UDim2.new(1, 0, 0, 100); title.Position = UDim2.new(0, 0, 0.2, 0)
title.BackgroundTransparency = 1; title.Text = "RADIO NGỌT 🍭\nSelect Language / Chọn Ngôn Ngữ"
title.TextColor3 = Color3.new(1,1,1); title.TextScaled = true; title.Font = Enum.Font.GothamBold

local btnEn = Instance.new("TextButton", bg)
btnEn.Size = UDim2.new(0, 200, 0, 50); btnEn.Position = UDim2.new(0.5, -210, 0.5, 0)
btnEn.Text = "ENGLISH"; btnEn.BackgroundColor3 = Color3.fromRGB(50, 50, 50); btnEn.TextColor3 = Color3.new(1,1,1)

local btnVn = Instance.new("TextButton", bg)
btnVn.Size = UDim2.new(0, 200, 0, 50); btnVn.Position = UDim2.new(0.5, 10, 0.5, 0)
btnVn.Text = "TIẾNG VIỆT"; btnVn.BackgroundColor3 = Color3.fromRGB(50, 50, 50); btnVn.TextColor3 = Color3.new(1,1,1)

local function StartScript(languageChoice)
    LangGui:Destroy()
    if languageChoice == "VN" then
        Lang = {
            esp = "👁️ ESP (Nhìn xuyên tường)", aim = "🎯 Aimbot", fly = "✈️ Fly (Bay bám đuổi)", fling = "🌪️ Fling (Hất văng)", troll = "🤡 Troll", stand = "🧍 Stand (Thử nghiệm)",
            aimMode = "Kiểu Ngắm", aimCam = "Ngắm bằng Camera", aimPlayer = "Ngắm bằng Người Chơi", switchAim = "🔄 Chuyển Đổi Mục Tiêu Khác",
            refresh = "🔄 Làm Mới Danh Sách Người Chơi", jerk = "🍆 Bật Jerk (Quay tay)", testing = "Khu vực này đang thử nghiệm..."
        }
    else
        Lang = {
            esp = "👁️ ESP (Wallhack)", aim = "🎯 Aimbot", fly = "✈️ Fly Lock-on", fling = "🌪️ Fling (Yeet)", troll = "🤡 Troll", stand = "🧍 Stand (Testing)",
            aimMode = "Aim Mode", aimCam = "Aim with Camera", aimPlayer = "Aim with Player", switchAim = "🔄 Switch Target Manually",
            refresh = "🔄 Refresh Player List", jerk = "🍆 Enable Jerk (Troll)", testing = "This area is in testing phase..."
        }
    end

    -- ==========================================
    -- 2. TẠO LOGO "RADIO NGỌT" (KÉO THẢ)
    -- ==========================================
    local LogoGui = Instance.new("ScreenGui")
    LogoGui.Name = "RadioNgot_Logo"
    LogoGui.Parent = pcall(function() return CoreGui end) and CoreGui or localPlayer.PlayerGui
    
    local ToggleBtn = Instance.new("ImageButton", LogoGui)
    ToggleBtn.Size = UDim2.new(0, 60, 0, 60); ToggleBtn.Position = UDim2.new(0.1, 0, 0.1, 0)
    ToggleBtn.Image = "rbxassetid://135835923984628"; ToggleBtn.BackgroundTransparency = 1
    local corner = Instance.new("UICorner", ToggleBtn); corner.CornerRadius = UDim.new(1, 0)
    
    local drag, startPos, dragStart
    ToggleBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            drag = true; dragStart = inp.Position; startPos = ToggleBtn.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if drag then
            local delta = inp.Position - dragStart
            ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function() drag = false end)

    -- ==========================================
    -- 3. KHỞI TẠO RAYFIELD UI
    -- ==========================================
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    local Window = Rayfield:CreateWindow({
       Name = "Radio Ngọt 🍭",
       LoadingTitle = "Radio Ngọt 🍭",
       LoadingSubtitle = "Script by Dev Khang",
       ConfigurationSaving = { Enabled = false },
       KeySystem = false
    })

    ToggleBtn.MouseButton1Click:Connect(function()
        local rf = CoreGui:FindFirstChild("Rayfield") or localPlayer.PlayerGui:FindFirstChild("Rayfield")
        if rf then rf.Enabled = not rf.Enabled end
    end)

    local function GetPlayers()
        local list = {}
        for _, v in pairs(Players:GetPlayers()) do if v ~= localPlayer then table.insert(list, v.Name) end end
        if #list == 0 then table.insert(list, "None") end
        return list
    end

    -- ==========================================
    -- TAB 1: ESP (Fix lỗi tự làm mới liên tục)
    -- ==========================================
    local EspTab = Window:CreateTab(Lang.esp)
    local espEnabled = false
    local espObjects = {}

    local function ClearESP(p)
        if espObjects[p] then espObjects[p]:Destroy(); espObjects[p] = nil end
    end

    RunService.RenderStepped:Connect(function()
        if not espEnabled then
            for p, obj in pairs(espObjects) do ClearESP(p) end
            return
        end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    if not espObjects[p] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 0, 100); hl.OutlineColor = Color3.new(1,1,1)
                        hl.FillTransparency = 0.5; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = CoreGui; hl.Adornee = p.Character
                        espObjects[p] = hl
                    else
                        espObjects[p].Adornee = p.Character
                    end
                else
                    ClearESP(p)
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(ClearESP)

    EspTab:CreateToggle({Name = "Bật / Tắt ESP", CurrentValue = false, Callback = function(v) espEnabled = v end})

    -- ==========================================
    -- TAB 2: AIMBOT (Giữ mục tiêu cho đến chết + Chọn kiểu ngắm)
    -- ==========================================
    local AimTab = Window:CreateTab(Lang.aim)
    local aimEnabled, showFov, aimTarget = false, false, nil
    local fovSize, aimMode = 150, "Camera"

    local fovCircle
    if Drawing then
        fovCircle = Drawing.new("Circle")
        fovCircle.Color = Color3.fromRGB(255, 255, 255); fovCircle.Thickness = 1; fovCircle.Filled = false
    end

    local function ScanNewTarget()
        local closest, dist = nil, fovSize
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local pos, vis = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if vis then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < dist then closest = p; dist = d end
                end
            end
        end
        return closest
    end

    RunService.RenderStepped:Connect(function()
        if fovCircle then
            fovCircle.Visible = showFov
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            fovCircle.Radius = fovSize
        end

        if aimEnabled then
            -- Chỉ đổi mục tiêu nếu chưa có, hoặc mục tiêu cũ đã chết/thoát game
            if not aimTarget or not aimTarget.Character or not aimTarget.Character:FindFirstChild("Humanoid") or aimTarget.Character.Humanoid.Health <= 0 then
                aimTarget = ScanNewTarget()
            end

            if aimTarget and aimTarget.Character and aimTarget.Character:FindFirstChild("Head") then
                local headPos = aimTarget.Character.Head.Position
                if aimMode == "Camera" then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, headPos)
                else -- Aim bằng Người
                    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = localPlayer.Character.HumanoidRootPart
                        hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(headPos.X, hrp.Position.Y, headPos.Z))
                    end
                end
            end
        else
            aimTarget = nil
        end
    end)

    AimTab:CreateToggle({Name = "Bật / Tắt Aimbot", CurrentValue = false, Callback = function(v) aimEnabled = v end})
    AimTab:CreateToggle({Name = "Hiện Vòng FOV", CurrentValue = false, Callback = function(v) showFov = v end})
    AimTab:CreateSlider({Name = "Kích thước FOV", Range = {50, 500}, Increment = 10, CurrentValue = 150, Callback = function(v) fovSize = v end})
    AimTab:CreateDropdown({Name = Lang.aimMode, Options = {Lang.aimCam, Lang.aimPlayer}, CurrentOption = Lang.aimCam, Callback = function(v) 
        if typeof(v) == "table" then v = v[1] end
        aimMode = (v == Lang.aimCam) and "Camera" or "Player"
    end})
    AimTab:CreateButton({Name = Lang.switchAim, Callback = function() aimTarget = ScanNewTarget() end}) -- Nút thủ công đổi mục tiêu

    -- ==========================================
    -- TAB 3 & 4: FLY, FLING (CÓ NÚT LÀM MỚI DANH SÁCH)
    -- ==========================================
    local FlyTab = Window:CreateTab(Lang.fly)
    local flyTarget = ""
    local FlyDrop = FlyTab:CreateDropdown({Name = "Mục Tiêu Fly", Options = GetPlayers(), CurrentOption = GetPlayers()[1], Callback = function(v) flyTarget = typeof(v)=="table" and v[1] or v end})
    FlyTab:CreateButton({Name = Lang.refresh, Callback = function() FlyDrop:Set(GetPlayers()) end})
    FlyTab:CreateToggle({Name = "Bật Fly Bám Đuổi", CurrentValue = false, Callback = function(v)
        -- Logic Fly bám gót cơ bản (Khang có thể mở rộng)
        if v then print("Đang bay theo " .. flyTarget) else print("Tắt bay") end
    end})

    local FlingTab = Window:CreateTab(Lang.fling)
    local flingActive, flingTarget, flingConn = false, "", nil
    local FlingDrop = FlingTab:CreateDropdown({Name = "Mục Tiêu Fling", Options = GetPlayers(), CurrentOption = GetPlayers()[1], Callback = function(v) flingTarget = typeof(v)=="table" and v[1] or v end})
    FlingTab:CreateButton({Name = Lang.refresh, Callback = function() FlingDrop:Set(GetPlayers()) end})
    
    FlingTab:CreateToggle({Name = "Bật Fling (Văng ra khỏi Map)", CurrentValue = false, Callback = function(v)
        flingActive = v
        if flingConn then flingConn:Disconnect(); flingConn = nil end
        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("SuperFling") then hrp.SuperFling:Destroy() end

        if flingActive and hrp then
            local spin = Instance.new("BodyAngularVelocity", hrp)
            spin.Name = "SuperFling"
            spin.AngularVelocity = Vector3.new(0, 999999, 0) -- Tốc độ siêu cao
            spin.MaxTorque = Vector3.new(0, math.huge, 0)
            
            flingConn = RunService.Heartbeat:Connect(function()
                hrp:SetNetworkOwner(localPlayer)
                local t = Players:FindFirstChild(flingTarget)
                if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                    hrp.CFrame = t.Character.HumanoidRootPart.CFrame
                    hrp.Velocity = Vector3.new(10000, 10000, 10000) -- Đẩy văng
                end
            end)
        else
            if hrp then hrp.Velocity = Vector3.new(0,0,0) end
        end
    end})

    -- ==========================================
    -- TAB 5: TROLL (JERK - QUAY TAY CHUẨN)
    -- ==========================================
    local TrollTab = Window:CreateTab(Lang.troll)
    local jerkActive, jerkConn, origC0 = false, nil, nil

    TrollTab:CreateToggle({Name = Lang.jerk, CurrentValue = false, Callback = function(v)
        jerkActive = v
        if jerkConn then jerkConn:Disconnect(); jerkConn = nil end
        local char = localPlayer.Character
        if not char then return end
        
        local isR6 = char:FindFirstChild("Torso") ~= nil
        local shoulder = isR6 and char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder") or char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder")
        
        if jerkActive and shoulder then
            if not origC0 then origC0 = shoulder.C0 end
            jerkConn = RunService.Heartbeat:Connect(function()
                -- Đưa tay vào giữa thân, đẩy xuống dưới 1 chút, và lắc ra trước sau
                local swing = math.sin(tick() * 40) * 0.5 
                shoulder.C0 = CFrame.new(-0.5, -1, -0.5) * CFrame.Angles(math.rad(90) + swing, 0, 0)
            end)
        else
            if shoulder and origC0 then shoulder.C0 = origC0 end
        end
    end})

    -- ==========================================
    -- TAB 6: STAND (THỬ NGHIỆM)
    -- ==========================================
    local StandTab = Window:CreateTab(Lang.stand)
    StandTab:CreateLabel(Lang.testing)
    
end

-- Lắng nghe sự kiện click nút ngôn ngữ
btnEn.MouseButton1Click:Connect(function() StartScript("EN") end)
btnVn.MouseButton1Click:Connect(function() StartScript("VN") end)
