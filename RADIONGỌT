local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local localPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
   Name = "Radio Ngọt 🍭 | Full Version",
   LoadingTitle = "Đang tải hệ thống...",
   LoadingSubtitle = "By Khang & Gemini",
   ConfigurationSaving = { Enabled = false }
})

local function GetPlayerNames()
    local names = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer then table.insert(names, player.Name) end
    end
    return names
end

local Stand_Tab = Window:CreateTab("Stand", 4483362458)
local standTarget = ""
local standPosition = "Bên Trái"
local isStandActive = false
local isAttacking = false
local lockedSkillPos = nil
local pointerGui = nil

Stand_Tab:CreateDropdown({Name = "Chọn Đồng Đội", Options = GetPlayerNames(), Callback = function(O) standTarget = typeof(O) == "table" and O[1] or O end})
Stand_Tab:CreateDropdown({Name = "Vị trí Stand", Options = {"Bên Trái", "Bên Phải", "Đằng Sau"}, Callback = function(O) standPosition = typeof(O) == "table" and O[1] or O end})
Stand_Tab:CreateToggle({Name = "Kích hoạt Stand", Callback = function(V)
    isStandActive = V
    if V then
        RunService.Heartbeat:Connect(function()
            if not isStandActive or standTarget == "" then return end
            local target = Players:FindFirstChild(standTarget)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local offset = isAttacking and CFrame.new(0, 0, -4) or (standPosition == "Bên Trái" and CFrame.new(-4,0,0) or standPosition == "Bên Phải" and CFrame.new(4,0,0) or CFrame.new(0,0,3))
                localPlayer.Character.HumanoidRootPart.CFrame = localPlayer.Character.HumanoidRootPart.CFrame:Lerp(target.Character.HumanoidRootPart.CFrame * offset, 0.2)
            end
        end)
    end
end})

Stand_Tab:CreateButton({Name = "1. Hiện cục đặt Skill", Callback = function()
    if pointerGui then pointerGui:Destroy() end
    pointerGui = Instance.new("ScreenGui", game.CoreGui)
    local f = Instance.new("Frame", pointerGui)
    f.Size = UDim2.new(0, 50, 0, 50); f.Position = UDim2.new(0.5, -25, 0.5, -25); f.BackgroundColor3 = Color3.new(1,0,0); f.Active = true; f.Draggable = true
    f.Name = "SkillNode"
end})

Stand_Tab:CreateButton({Name = "2. Khóa vị trí & Xuất chiêu", Callback = function()
    local node = game.CoreGui:FindFirstChild("SkillNode", true)
    if node then
        lockedSkillPos = {X = node.AbsolutePosition.X + 25, Y = node.AbsolutePosition.Y + 25}
        isAttacking = true
        VirtualInputManager:SendMouseButtonEvent(lockedSkillPos.X, lockedSkillPos.Y, 0, true, game, 1)
        task.wait(0.1)
        VirtualInputManager:SendMouseButtonEvent(lockedSkillPos.X, lockedSkillPos.Y, 0, false, game, 1)
        task.wait(1)
        isAttacking = false
    end
end})

local ESP_Tab = Window:CreateTab("ESP", 4483362458)
local espEnabled = false
ESP_Tab:CreateToggle({Name = "Bật ESP", Callback = function(V) espEnabled = V end})
RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local h = p.Character:FindFirstChild("Highlight") or Instance.new("Highlight", p.Character)
            h.Enabled = true
        end
    end
end)

local Fly_Tab = Window:CreateTab("Bay", 4483362458)
local flyActive = false
Fly_Tab:CreateToggle({Name = "Bật Bay Bám", Callback = function(V) flyActive = V end})
RunService.Heartbeat:Connect(function()
    if flyActive and standTarget ~= "" then
        local target = Players:FindFirstChild(standTarget)
        if target and target.Character then
            localPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
        end
    end
end)

local Fling_Tab = Window:CreateTab("Fling", 4483362458)
Fling_Tab:CreateButton({Name = "Fling Mục Tiêu", Callback = function()
    local t = Players:FindFirstChild(standTarget)
    if t and t.Character then
        local v = Instance.new("BodyVelocity", localPlayer.Character.HumanoidRootPart)
        v.Velocity = Vector3.new(9e9, 9e9, 9e9); task.wait(0.1); v:Destroy()
    end
end})
