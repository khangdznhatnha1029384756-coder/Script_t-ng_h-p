MoveTab:CreateButton({
   Name = "🔄 RESET DANH SÁCH FLY / LÀM SẠCH CACHE SERVER",
   Callback = function()
       Config.FlyActive = false
       if BodyGyro then BodyGyro:Destroy() end
       if BodyVelocity then BodyVelocity:Destroy() end
       if LP.Character and LP.Character:FindFirstChild("Humanoid") then
           LP.Character.Humanoid.PlatformStand = false
       end
       -- Làm sạch cache player trong danh sách server đối với Fly
       for _, p in pairs(Players:GetPlayers()) do
           if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
               for _, obj in pairs(p.Character.HumanoidRootPart:GetChildren()) do
                   if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                       obj:Destroy()
                   end
               end
           end
       end
       Rayfield:Notify({Title = "Radio Ngọt", Content = "Đã reset toàn bộ danh sách và cache Fly!", Duration = 2})
   end
})

