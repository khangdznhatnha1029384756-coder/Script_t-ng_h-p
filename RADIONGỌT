Tabs.Fly:AddSlider("FlyDist", {Title = "Khoảng Cách", Default = 5, Min = 1, Max = 20, Rounding = 1, Callback = function(v) flyDist = v end})
Tabs.Fly:AddSlider("FlySpeed", {Title = "Tốc Độ (Vòng tròn)", Default = 15, Min = 5, Max = 50, Rounding = 1, Callback = function(v) flySpeed = v end})

Tabs.Fly:AddToggle("TogFly", {Title = "🟢 Bật Fly Lock-on", Default = false, Callback = function(V)
    if V then
        SetMode("Fly")
        local angle = 0
        activeConnection = RunService.Heartbeat:Connect(function()
            FixLag()
            local target = Players:FindFirstChild(flyTarget)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local tPos = target.Character.HumanoidRootPart.Position
                local goalCF = CFrame.new(tPos)
                if flyStyle == "Trên đầu" then goalCF = CFrame.new(tPos + Vector3.new(0, flyDist, 0))
                elseif flyStyle == "Bám gót" then goalCF = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, flyDist)
                elseif flyStyle == "Bay vòng tròn" then
                    angle = angle + math.rad(flySpeed)
                    goalCF = CFrame.new(tPos + Vector3.new(math.cos(angle)*flyDist, 0, math.sin(angle)*flyDist))
                end
                localPlayer.Character.HumanoidRootPart.CFrame = localPlayer.Character.HumanoidRootPart.CFrame:Lerp(goalCF, 0.25)
            end
        end)
    else if activeMode == "Fly" then StopAllModes() end end
end})

