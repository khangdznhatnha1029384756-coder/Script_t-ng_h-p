-- ==========================================
-- TAB ESP (Đầy đủ Máu, Tên, Box, Tracer, Rainbow)
-- ==========================================
local ESP_Enabled, showBox, showName, showTracer = false, true, true, true
local espColor = Color3.fromRGB(255, 105, 180)
local rainbowESP, rainbowHue = false, 0
local esp_Objects = {}

local function UpdateESPVisibility()
    for _, data in pairs(esp_Objects) do
        if data.highlight then data.highlight.Enabled = ESP_Enabled and showBox; data.highlight.FillColor = espColor end
        if data.billboard then data.billboard.Enabled = ESP_Enabled and showName end
        if data.tracer then data.tracer.Visible = ESP_Enabled and showTracer; data.tracer.Color = espColor end
    end
end

local function CreateESP(player)
    if player == localPlayer or esp_Objects[player] then return end
    local data = {}
    
    data.highlight = Instance.new("Highlight")
    data.highlight.FillTransparency = 0.5; data.highlight.OutlineTransparency = 0
    data.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop 
    
    data.billboard = Instance.new("BillboardGui")
    data.billboard.AlwaysOnTop = true; data.billboard.Size = UDim2.new(0, 200, 0, 40); data.billboard.StudsOffset = Vector3.new(0, 3, 0)
    
    data.nameTxt = Instance.new("TextLabel", data.billboard)
    data.nameTxt.BackgroundTransparency = 1; data.nameTxt.Size = UDim2.new(1, 0, 0.5, 0)
    data.nameTxt.Font = Enum.Font.GothamBold; data.nameTxt.TextSize = 14; data.nameTxt.TextStrokeTransparency = 0; data.nameTxt.TextColor3 = espColor; data.nameTxt.Text = player.Name
    
    data.hpTxt = Instance.new("TextLabel", data.billboard)
    data.hpTxt.BackgroundTransparency = 1; data.hpTxt.Size = UDim2.new(1, 0, 0.5, 0); data.hpTxt.Position = UDim2.new(0, 0, 0.5, 0)
    data.hpTxt.Font = Enum.Font.GothamBold; data.hpTxt.TextSize = 12; data.hpTxt.TextStrokeTransparency = 0
    
    data.tracer = Drawing.new("Line")
    data.tracer.Thickness = 2; data.tracer.Transparency = 1

    local function setupChar(char)
        if char then
            data.highlight.Parent = char; data.highlight.Adornee = char
            if char:WaitForChild("Head", 5) then data.billboard.Parent = char.Head end
        end
    end
    data.charAddedConn = player.CharacterAdded:Connect(setupChar)
    if player.Character then setupChar(player.Character) end

    data.renderConn = RunService.RenderStepped:Connect(function()
        if not ESP_Enabled then data.tracer.Visible = false; return end
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local hum = player.Character.Humanoid
            data.hpTxt.Text = "HP: " .. math.floor(hum.Health)
            if hum.Health > (hum.MaxHealth * 0.5) then data.hpTxt.TextColor3 = Color3.fromRGB(0, 255, 0) else data.hpTxt.TextColor3 = Color3.fromRGB(255, 0, 0) end
            
            if showTracer then
                local vector, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    data.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    data.tracer.To = Vector2.new(vector.X, vector.Y)
                    data.tracer.Visible = true
                else data.tracer.Visible = false end
            else data.tracer.Visible = false end
        else data.tracer.Visible = false end
    end)
    esp_Objects[player] = data
end

local function RemoveESP(player)
    if esp_Objects[player] then
        if esp_Objects[player].highlight then esp_Objects[player].highlight:Destroy() end
        if esp_Objects[player].billboard then esp_Objects[player].billboard:Destroy() end
        if esp_Objects[player].tracer then esp_Objects[player].tracer:Remove() end
        if esp_Objects[player].charAddedConn then esp_Objects[player].charAddedConn:Disconnect() end
        if esp_Objects[player].renderConn then esp_Objects[player].renderConn:Disconnect() end
        esp_Objects[player] = nil
    end
end

RunService.Heartbeat:Connect(function(dt)
    if ESP_Enabled and rainbowESP then
        rainbowHue = (rainbowHue + (dt * 0.2)) % 1
        espColor = Color3.fromHSV(rainbowHue, 1, 1)
        for _, data in pairs(esp_Objects) do if data.nameTxt then data.nameTxt.TextColor3 = espColor end end
        UpdateESPVisibility()
    end
end)

Players.PlayerAdded:Connect(function(p) if ESP_Enabled then CreateESP(p) end end)
Players.PlayerRemoving:Connect(RemoveESP)

Tabs.ESP:AddToggle("ToggleESP", {Title = "Bật ESP", Default = false, Callback = function(v) 
    ESP_Enabled = v
    if v then for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end else for _, p in pairs(Players:GetPlayers()) do RemoveESP(p) end end
    UpdateESPVisibility() 
end})
Tabs.ESP:AddToggle("ToggleBox", {Title = "Hiện Box 3D", Default = true, Callback = function(v) showBox = v; UpdateESPVisibility() end})
Tabs.ESP:AddToggle("ToggleName", {Title = "Hiện Tên & Máu", Default = true, Callback = function(v) showName = v; UpdateESPVisibility() end})
Tabs.ESP:AddToggle("ToggleTracer", {Title = "Hiện Dây Tracer", Default = true, Callback = function(v) showTracer = v; UpdateESPVisibility() end})
Tabs.ESP:AddToggle("ToggleRainbow", {Title = "Màu Cầu Vồng (Rainbow)", Default = false, Callback = function(v) rainbowESP = v end})
Tabs.ESP:AddColorpicker("ColorESP", {Title = "Đổi Màu ESP", Default = espColor, Callback = function(v) espColor = v; UpdateESPVisibility() end})

