FlyTab:CreateSlider({Name = "Tốc Độ Bay Vòng Tròn", Range = {5, 60}, Increment = 1, CurrentValue = 15, Callback = function(v) flySpeed = v end})

FlyTab:CreateToggle({Name = "🟢 Bật Fly Lock-on", CurrentValue = false, Callback = function(v)
    flyActive = v
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyActive then
        local angle = 0
        flyConn = RunService.Heartbeat:Connect(function()
            FixLag()
            local target = Players:FindFirstChild(flyTarget)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local tPos = target.Character.HumanoidRootPart.Position
                local goalCF = CFrame.new(tPos)
                if flyStyle == "Trên đầu" then goalCF = CFrame.new(tPos + Vector3.new(0, flyDist, 0))
                elseif flyStyle == "Bám gót" then goalCF = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, flyDist)
                elseif flyStyle == "Bay vòng tròn" then
                    angle = angle + math.rad(flySpeed)
                    goalCF = CFrame.new(tPos + Vector3.new(math.cos(angle)*flyDist, 0, math.sin(angle)*flyDist))
                end
                localPlayer.Character.HumanoidRootPart.CFrame = localPlayer.Character.HumanoidRootPart.CFrame:Lerp(goalCF, 0.3)
            end
        end)
    end
end})

