-- ==========================================
-- VÒNG LẶP XỬ LÝ TOÀN CỤC (RENDER STEPPED)
-- ==========================================
RunService.RenderStepped:Connect(function()
    -- 1. Aimbot khóa mục tiêu gần nhất
    if Config.AimActive then
        local closestTarget = nil
        local shortestDist = math.huge
        local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild(Config.AimPart) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local partPos = p.Character[Config.AimPart].Position
                local screenPos, onScreen = Camera:WorldToViewportPoint(partPos)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestTarget = p
                    end
                end
            end
        end
        
        if closestTarget and closestTarget.Character and closestTarget.Character:FindFirstChild(Config.AimPart) then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Character[Config.AimPart].Position)
        end
    end

    -- 2. ESP Chi tiết tự động nhận diện người ra/vào server
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local char = p.Character
            local hrp = char.HumanoidRootPart
            local head = char:FindFirstChild("Head")
            
            -- ESP Box
            local boxHL = char:FindFirstChild("RadioESP_Box")
            if Config.ESP_Box and char.Humanoid.Health > 0 then
                if not boxHL then
                    boxHL = Instance.new("Highlight", char)
                    boxHL.Name = "RadioESP_Box"
                    boxHL.FillColor = Color3.fromRGB(255, 0, 0)
                    boxHL.OutlineColor = Color3.fromRGB(255, 255, 255)
                    boxHL.FillTransparency = 0.5
                end
            else
                if boxHL then boxHL:Destroy() end
            end
            
            -- ESP Tên, Máu, Khoảng cách
            local infoTag = head and head:FindFirstChild("RadioESP_Info")
            if (Config.ESP_Name or Config.ESP_Health or Config.ESP_Dist) and char.Humanoid.Health > 0 and head then
                if not infoTag then
                    infoTag = Instance.new("BillboardGui", head)
                    infoTag.Name = "RadioESP_Info"
                    infoTag.Size = UDim2.new(0, 200, 0, 70)
                    infoTag.AlwaysOnTop = true
                    infoTag.StudsOffset = Vector3.new(0, 3, 0)
                    
                    local txt = Instance.new("TextLabel", infoTag)
                    txt.Name = "Text"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 12
                end
                
                local textStr = ""
                if Config.ESP_Name then textStr = textStr .. "👤 Tên: " .. p.Name .. "\n" end
                if Config.ESP_Health then textStr = textStr .. "❤️ Máu (HP): " .. math.floor(char.Humanoid.Health) .. "\n" end
                if Config.ESP_Dist and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                    local distance = math.floor((LP.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                    textStr = textStr .. "📍 Khoảng cách: " .. distance .. " Studs"
                end
                infoTag.Text.Text = textStr
            else
                if infoTag then infoTag:Destroy() end
            end
        end
    end

    -- 3. Kiểu bay cốt lõi Radio Ngọt: Bay vòng tròn xung quanh, đằng sau lưng và trên đầu mục tiêu / camera
    if Config.FlyActive and BodyVelocity and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LP.Character.HumanoidRootPart
        local angle = tick() * (Config.FlySpeed * 0.1)
        -- Tạo quỹ đạo bay vòng tròn xung quanh vị trí camera kết hợp độ cao trên đầu
        local camPos = Camera.CFrame.Position
        local targetOffset = Vector3.new(math.cos(angle) * Config.FlyRadius, Config.FlyHeight, math.sin(angle) * Config.FlyRadius)
        local targetPos = camPos + targetOffset
        
        if BodyGyro then BodyGyro.CFrame = Camera.CFrame end
        BodyVelocity.Velocity = (targetPos - hrp.Position) * 5
    end
end)
