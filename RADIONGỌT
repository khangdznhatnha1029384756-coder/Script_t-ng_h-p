-- ==========================================
-- TAB 3: TROLL & MISC (TAY JERK CHUẨN IY)
-- ==========================================
local TrollTab = Window:CreateTab("Troll & Misc", "ghost")
local jerkConnection, originalShoulderC0

TrollTab:CreateSection("Trolling & Tính Năng Phụ")
TrollTab:CreateToggle({
   Name = "Hand Jerk (Chuẩn chỉnh vị trí menu Infinite Yield)",
   CurrentValue = false,
   Callback = function(v)
       Config.JerkActive = v
       local char = LP.Character
       local shoulder = char and (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder") or char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder"))
       
       if v and shoulder then
           if not originalShoulderC0 then originalShoulderC0 = shoulder.C0 end
           jerkConnection = RunService.Heartbeat:Connect(function()
               if shoulder and shoulder.Parent then
                   local swing = math.sin(tick() * 50) * 0.7
                   shoulder.C0 = CFrame.new(-0.5, -1, -0.5) * CFrame.Angles(math.rad(90) + swing, 0, 0)
               end
           end)
       else
           if jerkConnection then
               jerkConnection:Disconnect()
               jerkConnection = nil
           end
           if shoulder and originalShoulderC0 then
               shoulder.C0 = originalShoulderC0
               originalShoulderC0 = nil
           end
       end
   end
})

TrollTab:CreateButton({
   Name = "🔄 Refresh Toàn Bộ Cache Người Chơi Trong Server",
   Callback = function()
       for _, p in pairs(Players:GetPlayers()) do
           if p.Character then
               if p.Character:FindFirstChild("RadioESP_Box") then p.Character.RadioESP_Box:Destroy() end
               if p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("RadioESP_Info") then p.Character.Head.RadioESP_Info:Destroy() end
           end
       end
       Rayfield:Notify({Title = "Radio Ngọt", Content = "Đã dọn sạch toàn bộ cache người chơi!", Duration = 2})
   end
})

TrollTab:CreateButton({
