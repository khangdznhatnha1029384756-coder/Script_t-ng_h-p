-- ==========================================
-- 1. TỐI ƯU HÓA (GIẢM LAG & NETWORK OWNER)
-- ==========================================
local function FixLag()
    localPlayer.MaximumSimulationRadius = 1000
    localPlayer.SimulationRadius = 1000
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        localPlayer.Character.HumanoidRootPart:SetNetworkOwner(localPlayer)
    end
end

-- ==========================================
-- 2. HỆ THỐNG QUẢN LÝ CHẾ ĐỘ
-- ==========================================
local activeMode = "None" 
local activeConnection = nil

local function StopAllModes()
    if activeConnection then activeConnection:Disconnect(); activeConnection = nil end
    local myChar = localPlayer.Character
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local hrp = myChar.HumanoidRootPart
        if hrp:FindFirstChild("FlingSpin") then hrp.FlingSpin:Destroy() end
        hrp.Velocity = Vector3.new(0,0,0)
        hrp.RotVelocity = Vector3.new(0,0,0)
    end
    activeMode = "None"
end

local function SetMode(newMode)
    StopAllModes()
    activeMode = newMode
end

local function GetPlayerNames()
    local names = {}
    for _, p in pairs(Players:GetPlayers()) do 
        if p ~= localPlayer then table.insert(names, p.Name) end
    end
    return names
end

