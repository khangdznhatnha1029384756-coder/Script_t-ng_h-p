local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Camera = workspace.CurrentCamera
local LP = Players.LocalPlayer

-- Xóa UI cũ nếu bị trùng
if CoreGui:FindFirstChild("RadioNgotBoot") then CoreGui.RadioNgotBoot:Destroy() end
if CoreGui:FindFirstChild("RadioNgotMain") then CoreGui.RadioNgotMain:Destroy() end

-- ==========================================
-- BƯỚC 1: HỆ THỐNG BOOT (CHỌN NGÔN NGỮ)
-- ==========================================
local BootGui = Instance.new("ScreenGui", CoreGui)
BootGui.Name = "RadioNgotBoot"

local BootFrame = Instance.new("Frame", BootGui)
BootFrame.Size = UDim2.new(0, 300, 0, 200)
BootFrame.Position = UDim2.new(0.5, -150, 0.5, -100)
BootFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Instance.new("UICorner", BootFrame).CornerRadius = UDim.new(0, 10)

local Title = Instance.new("TextLabel", BootFrame)
Title.Size = UDim2.new(1, 0, 0, 50)
Title.BackgroundTransparency = 1
Title.Text = "RADIO NGỌT 🍭\nChọn Ngôn Ngữ / Select Language"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 14

local Lang = "VN" -- Mặc định

local BtnVN = Instance.new("TextButton", BootFrame)
BtnVN.Size = UDim2.new(0, 120, 0, 40)
BtnVN.Position = UDim2.new(0, 20, 0, 70)
BtnVN.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
BtnVN.Text = "Tiếng Việt"
BtnVN.Font = Enum.Font.GothamBold
Instance.new("UICorner", BtnVN)

local BtnEN = Instance.new("TextButton", BootFrame)
BtnEN.Size = UDim2.new(0, 120, 0, 40)
BtnEN.Position = UDim2.new(1, -140, 0, 70)
BtnEN.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
BtnEN.Text = "English"
BtnEN.TextColor3 = Color3.new(1, 1, 1)
BtnEN.Font = Enum.Font.GothamBold
Instance.new("UICorner", BtnEN)

local ActivateBtn = Instance.new("TextButton", BootFrame)
ActivateBtn.Size = UDim2.new(0, 260, 0, 50)
ActivateBtn.Position = UDim2.new(0, 20, 0, 130)
ActivateBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
ActivateBtn.Text = "KÍCH HOẠT SCRIPT"
ActivateBtn.TextColor3 = Color3.new(1, 1, 1)
ActivateBtn.Font = Enum.Font.GothamBold
ActivateBtn.TextSize = 16
Instance.new("UICorner", ActivateBtn)

BtnVN.MouseButton1Click:Connect(function()
    Lang = "VN"
    BtnVN.BackgroundColor3 = Color3.fromRGB(50, 255, 50); BtnVN.TextColor3 = Color3.new(0, 0, 0)
    BtnEN.BackgroundColor3 = Color3.fromRGB(50, 50, 50); BtnEN.TextColor3 = Color3.new(1, 1, 1)
    ActivateBtn.Text = "KÍCH HOẠT SCRIPT"
end)

BtnEN.MouseButton1Click:Connect(function()
    Lang = "EN"
    BtnEN.BackgroundColor3 = Color3.fromRGB(50, 255, 50); BtnEN.TextColor3 = Color3.new(0, 0, 0)
    BtnVN.BackgroundColor3 = Color3.fromRGB(50, 50, 50); BtnVN.TextColor3 = Color3.new(1, 1, 1)
    ActivateBtn.Text = "ACTIVATE SCRIPT"
end)

-- ==========================================
-- BƯỚC 2: HÀM CHẠY SCRIPT CHÍNH SAU KHI KÍCH HOẠT
-- ==========================================
local function StartMainScript()
    BootGui:Destroy()

    -- Từ điển đa ngôn ngữ
    local T = {
        VN = {
            AimOn = "🎯 AIM KHÓA: [ BẬT ]", AimOff = "🎯 AIM KHÓA: [ TẮT ]", SwitchAim = "🔄 Bỏ Qua & Đổi Mục Tiêu Aim",
            TabCombat = "Combat & ESP", TabMove = "Di Chuyển (Fly/Fling)", TabMisc = "Tính Năng Phụ",
            AimLockUIName = "Khóa vị trí nút Aim trên màn hình", 
            ESPBox = "ESP Hộp (Box)", ESPName = "ESP Tên", ESPHP = "ESP Máu", ESPDist = "ESP Khoảng Cách",
            FlyTarget = "Chọn người để bay bám theo", RefreshFly = "🔄 Làm Mới Danh Sách Người Bay", ToggleFly = "Bật/Tắt Bay Vòng Tròn (Orbit Fly)",
            Speed = "Điền Tốc Độ Bay", Radius = "Điền Bán Kính (Radius)", Height = "Điền Độ Cao (Height)",
            FlingTarget = "Chọn người để Hất Văng (Fling)", RefreshFling = "🔄 Làm Mới Danh Sách Fling", ToggleFling = "Bật/Tắt Fling (Tự động chuyển mục tiêu khi chết)",
            Jerk = "Tay Jerk (Infinite Yield)"
        },
        EN = {
            AimOn = "🎯 AIM LOCK: [ ON ]", AimOff = "🎯 AIM LOCK: [ OFF ]", SwitchAim = "🔄 Skip & Switch Aim Target",
            TabCombat = "Combat & ESP", TabMove = "Movement (Fly/Fling)", TabMisc = "Misc",
            AimLockUIName = "Lock Aim UI Position", 
            ESPBox = "ESP Box", ESPName = "ESP Name", ESPHP = "ESP Health", ESPDist = "ESP Distance",
            FlyTarget = "Select Fly Target", RefreshFly = "🔄 Refresh Fly Player List", ToggleFly = "Toggle Orbit Fly",
            Speed = "Input Speed", Radius = "Input Radius", Height = "Input Height",
            FlingTarget = "Select Fling Target", RefreshFling = "🔄 Refresh Fling Player List", ToggleFling = "Toggle Auto-Reset Fling",
            Jerk = "Hand Jerk (Infinite Yield)"
        }
    }
    local L = T[Lang]

    -- Config tổng phân tách rạch ròi
    local Config = {
        AimActive = false, AimTargetPlayer = nil, IgnoreAimList = {},
        ESP_Box = false, ESP_Name = false, ESP_Health = false, ESP_Dist = false,
        FlyActive = false, FlyTarget = "", FlySpeed = 20, FlyRadius = 10, FlyHeight = 5,
        FlingActive = false, FlingTarget = "",
        JerkActive = false
    }

    local function GetPlayerNames()
        local names = {}
        for _, p in pairs(Players:GetPlayers()) do if p ~= LP then table.insert(names, p.Name) end end
        return names
    end

    -- Khởi tạo UI Aim Trên Màn Hình
    local MainGui = Instance.new("ScreenGui", CoreGui)
    MainGui.Name = "RadioNgotMain"

    local AimScreenBtn = Instance.new("TextButton", MainGui)
    AimScreenBtn.Size = UDim2.new(0, 180, 0, 40); AimScreenBtn.Position = UDim2.new(0, 20, 0.35, 0)
    AimScreenBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15); AimScreenBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
    AimScreenBtn.Text = L.AimOff; AimScreenBtn.Font = Enum.Font.GothamBold; AimScreenBtn.TextSize = 12
    AimScreenBtn.Active = true; AimScreenBtn.Draggable = true
    Instance.new("UICorner", AimScreenBtn).CornerRadius = UDim.new(0, 6)

    local SwitchAimBtn = Instance.new("TextButton", MainGui)
    SwitchAimBtn.Size = UDim2.new(0, 180, 0, 30); SwitchAimBtn.Position = UDim2.new(0, 20, 0.35, 45)
    SwitchAimBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25); SwitchAimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SwitchAimBtn.Text = L.SwitchAim; SwitchAimBtn.Font = Enum.Font.GothamSemibold; SwitchAimBtn.TextSize = 10
    SwitchAimBtn.Active = true; SwitchAimBtn.Draggable = true
    Instance.new("UICorner", SwitchAimBtn).CornerRadius = UDim.new(0, 6)

    AimScreenBtn.MouseButton1Click:Connect(function()
        Config.AimActive = not Config.AimActive
        AimScreenBtn.Text = Config.AimActive and L.AimOn or L.AimOff
        AimScreenBtn.TextColor3 = Config.AimActive and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
        if not Config.AimActive then Config.AimTargetPlayer = nil; Config.IgnoreAimList = {} end
    end)

    SwitchAimBtn.MouseButton1Click:Connect(function()
        if Config.AimTargetPlayer then
            Config.IgnoreAimList[Config.AimTargetPlayer.Name] = true -- Đưa vào danh sách bỏ qua để tìm đứa khác
            Config.AimTargetPlayer = nil
        end
    end)

    -- Khởi tạo Rayfield
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    local Window = Rayfield:CreateWindow({
       Name = "RADIO NGỌT 🍭 | DEV KHANG",
       LoadingTitle = "Đang tải hệ thống...",
       LoadingSubtitle = "Phiên bản gộp chức năng hoàn chỉnh",
       ConfigurationSaving = {Enabled = false}
    })

    -- TAB 1: COMBAT
    local CombatTab = Window:CreateTab(L.TabCombat, "crosshair")
    CombatTab:CreateToggle({Name = L.AimLockUIName, CurrentValue = false, Callback = function(v) AimScreenBtn.Draggable = not v; SwitchAimBtn.Draggable = not v end})
    CombatTab:CreateSection("ESP CONFIG")
    CombatTab:CreateToggle({Name = L.ESPBox, Callback = function(v) Config.ESP_Box = v end})
    CombatTab:CreateToggle({Name = L.ESPName, Callback = function(v) Config.ESP_Name = v end})
    CombatTab:CreateToggle({Name = L.ESPHP, Callback = function(v) Config.ESP_Health = v end})
    CombatTab:CreateToggle({Name = L.ESPDist, Callback = function(v) Config.ESP_Dist = v end})

    -- TAB 2: MOVEMENT (FLY & FLING TÁCH RIÊNG HOÀN TOÀN)
    local MoveTab = Window:CreateTab(L.TabMove, "move")
    local BodyGyro, BodyVelocity, FlingSpin
    
    MoveTab:CreateSection("--- HỆ THỐNG BAY VÒNG TRÒN (FLY) ---")
    local FlyDropdown = MoveTab:CreateDropdown({Name = L.FlyTarget, Options = GetPlayerNames(), CurrentOption = "", MultipleOptions = false, Callback = function(Opt) Config.FlyTarget = Opt[1] end})
    MoveTab:CreateButton({Name = L.RefreshFly, Callback = function() FlyDropdown:Refresh(GetPlayerNames(), true) end})
    
    MoveTab:CreateToggle({
       Name = L.ToggleFly,
       Callback = function(v)
           Config.FlyActive = v
           local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
           if v and hrp then
               LP.Character.Humanoid.PlatformStand = true
               BodyGyro = Instance.new("BodyGyro", hrp); BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
               BodyVelocity = Instance.new("BodyVelocity", hrp); BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
           else
               if hrp then LP.Character.Humanoid.PlatformStand = false end
               if BodyGyro then BodyGyro:Destroy() end
               if BodyVelocity then BodyVelocity:Destroy() end
           end
       end
    })
    MoveTab:CreateInput({Name = L.Speed, PlaceholderText = "20", Callback = function(t) Config.FlySpeed = tonumber(t) or 20 end})
    MoveTab:CreateInput({Name = L.Radius, PlaceholderText = "10", Callback = function(t) Config.FlyRadius = tonumber(t) or 10 end})
    MoveTab:CreateInput({Name = L.Height, PlaceholderText = "5", Callback = function(t) Config.FlyHeight = tonumber(t) or 5 end})

    MoveTab:CreateSection("--- HỆ THỐNG FLING (AUTO RESET) ---")
    local FlingDropdown = MoveTab:CreateDropdown({Name = L.FlingTarget, Options = GetPlayerNames(), CurrentOption = "", MultipleOptions = false, Callback = function(Opt) Config.FlingTarget = Opt[1] end})
    MoveTab:CreateButton({Name = L.RefreshFling, Callback = function() FlingDropdown:Refresh(GetPlayerNames(), true) end})

    MoveTab:CreateToggle({
       Name = L.ToggleFling,
       Callback = function(v)
           Config.FlingActive = v
           local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
           if v and hrp then
               FlingSpin = Instance.new("BodyAngularVelocity", hrp)
               FlingSpin.AngularVelocity = Vector3.new(0, 99999, 0); FlingSpin.MaxTorque = Vector3.new(0, math.huge, 0)
           else
               if FlingSpin then FlingSpin:Destroy() end
           end
       end
    })

    -- TAB 3: TROLL & MISC
    local MiscTab = Window:CreateTab(L.TabMisc, "ghost")
    local jerkConn, origC0
    MiscTab:CreateToggle({
       Name = L.Jerk,
       Callback = function(v)
           local shoulder = LP.Character and (LP.Character:FindFirstChild("Torso") and LP.Character.Torso:FindFirstChild("Right Shoulder") or LP.Character:FindFirstChild("RightUpperArm") and LP.Character.RightUpperArm:FindFirstChild("RightShoulder"))
           if v and shoulder then
               origC0 = origC0 or shoulder.C0
               jerkConn = RunService.Heartbeat:Connect(function()
                   shoulder.C0 = CFrame.new(-0.5, -1, -0.5) * CFrame.Angles(math.rad(90) + math.sin(tick() * 50) * 0.7, 0, 0)
               end)
           else
               if jerkConn then jerkConn:Disconnect() end
               if shoulder and origC0 then shoulder.C0 = origC0 end
           end
       end
    })

    -- VÒNG LẶP XỬ LÝ TOÀN CỤC (CORE LOGIC)
    RunService.RenderStepped:Connect(function()
        -- 1. AIMBOT (Khóa & Chuyển Đổi)
        if Config.AimActive then
            if not Config.AimTargetPlayer or not Config.AimTargetPlayer.Character or not Config.AimTargetPlayer.Character:FindFirstChild("Head") or Config.AimTargetPlayer.Character.Humanoid.Health <= 0 then
                local shortest = math.huge
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character and p.Character:FindFirstChild("Head") and not Config.IgnoreAimList[p.Name] then
                        local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                            if dist < shortest then shortest = dist; Config.AimTargetPlayer = p end
                        end
                    end
                end
            end
            if Config.AimTargetPlayer and Config.AimTargetPlayer.Character and Config.AimTargetPlayer.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, Config.AimTargetPlayer.Character.Head.Position)
            end
        end

        -- 2. ESP TOÀN DIỆN
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local char = p.Character
                local box = char:FindFirstChild("RN_Box")
                if Config.ESP_Box then
                    if not box then
                        box = Instance.new("Highlight", char); box.Name = "RN_Box"; box.FillColor = Color3.new(1,0,0); box.OutlineColor = Color3.new(1,1,1); box.FillTransparency = 0.5
                    end
                else if box then box:Destroy() end end
                
                local head = char:FindFirstChild("Head")
                local info = head and head:FindFirstChild("RN_Info")
                if (Config.ESP_Name or Config.ESP_Health or Config.ESP_Dist) and head then
                    if not info then
                        info = Instance.new("BillboardGui", head); info.Name = "RN_Info"; info.Size = UDim2.new(0,200,0,50); info.AlwaysOnTop = true; info.StudsOffset = Vector3.new(0,3,0)
                        local txt = Instance.new("TextLabel", info); txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1; txt.TextColor3 = Color3.new(1,1,1); txt.Font = Enum.Font.GothamBold; txt.TextSize = 12
                    end
                    local str = ""
                    if Config.ESP_Name then str = str .. p.Name .. "\n" end
                    if Config.ESP_Health and char:FindFirstChild("Humanoid") then str = str .. "HP: " .. math.floor(char.Humanoid.Health) .. "\n" end
                    if Config.ESP_Dist and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                        str = str .. math.floor((LP.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude) .. " Studs"
                    end
                    info.TextLabel.Text = str
                else if info then info:Destroy() end end
            end
        end

        -- 3. FLY BÁM ĐUÔI VÀ XOAY VÒNG (ĐỘC LẬP)
        if Config.FlyActive and BodyVelocity and Config.FlyTarget ~= "" then
            local tPlayer = Players:FindFirstChild(Config.FlyTarget)
            if tPlayer and tPlayer.Character and tPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = tPlayer.Character.HumanoidRootPart
                local myHRP = LP.Character.HumanoidRootPart
                local angle = tick() * Config.FlySpeed * 0.1
                local targetPos = tHRP.Position + Vector3.new(math.cos(angle) * Config.FlyRadius, Config.FlyHeight, math.sin(angle) * Config.FlyRadius)
                BodyGyro.CFrame = CFrame.new(myHRP.Position, tHRP.Position)
                BodyVelocity.Velocity = (targetPos - myHRP.Position) * 10
            end
        end
        
        -- 4. FLING VÀ AUTO-RESET ĐỔI MỤC TIÊU KHI ĐỊCH CHẾT (ĐỘC LẬP)
        if Config.FlingActive and FlingSpin and Config.FlingTarget ~= "" then
            local tPlayer = Players:FindFirstChild(Config.FlingTarget)
            if tPlayer and tPlayer.Character and tPlayer.Character:FindFirstChild("Humanoid") then
                if tPlayer.Character.Humanoid.Health <= 0 then
                    -- Địch đã chết -> Tự động tìm mục tiêu mới để tiếp tục Fling
                    for _, nextPlayer in pairs(Players:GetPlayers()) do
                        if nextPlayer ~= LP and nextPlayer.Name ~= tPlayer.Name and nextPlayer.Character and nextPlayer.Character:FindFirstChild("Humanoid") and nextPlayer.Character.Humanoid.Health > 0 then
                            Config.FlingTarget = nextPlayer.Name
                            Rayfield:Notify({Title = "Fling Auto-Reset", Content = "Địch đã chết! Tự động chuyển Fling sang: " .. nextPlayer.Name, Duration = 2})
                            break
                        end
                    end
                else
                    -- Di chuyển đâm thẳng vào địch
                    LP.Character.HumanoidRootPart.CFrame = tPlayer.Character.HumanoidRootPart.CFrame
                end
            end
        end
    end)
end

ActivateBtn.MouseButton1Click:Connect(StartMainScript)
