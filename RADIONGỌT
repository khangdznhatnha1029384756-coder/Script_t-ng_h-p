local aimbotEnabled, showFOV = false, false
local fovRadius, aimSmoothness, aimPart = 100, 1, "Head"
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false; fovCircle.Filled = false; fovCircle.Thickness = 1; fovCircle.Color = Color3.fromRGB(255, 255, 255)

Tabs.Aimbot:AddToggle("TogAimbot", {Title = "Bật Aimbot", Default = false, Callback = function(v) aimbotEnabled = v end})
Tabs.Aimbot:AddToggle("TogFOV", {Title = "Hiện Vòng FOV", Default = false, Callback = function(v) showFOV = v; fovCircle.Visible = v end})
Tabs.Aimbot:AddSlider("FOVSize", {Title = "Kích Thước Vòng FOV", Default = 100, Min = 50, Max = 500, Rounding = 1, Callback = function(v) fovRadius = v; fovCircle.Radius = v end})
Tabs.Aimbot:AddSlider("AimSmooth", {Title = "Độ Mượt (Smoothness)", Default = 1, Min = 1, Max = 10, Rounding = 1, Callback = function(v) aimSmoothness = v end})
Tabs.Aimbot:AddDropdown("AimPart", {Title = "Vị trí ngắm", Values = {"Head", "HumanoidRootPart"}, Default = 1, Callback = function(v) aimPart = v end})

RunService.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if aimbotEnabled then
        local target, shortestDist = nil, fovRadius
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character and p.Character:FindFirstChild(aimPart) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character[aimPart].Position)
                if onScreen then
                    local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if mag < shortestDist then target = p; shortestDist = mag end
                end
            end
        end
        if target then
            local goalCFrame = CFrame.new(Camera.CFrame.Position, target.Character[aimPart].Position)
            if aimSmoothness == 1 then Camera.CFrame = goalCFrame else Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 1 / aimSmoothness) end
        end
    end
end)

